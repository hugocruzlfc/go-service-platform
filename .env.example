# Copy this file to .env and fill in the values. .env is ignored by git.

# PostgreSQL connection used by cmd/api and cmd/migrate.
# The value below points to the local Docker Compose database.
DATABASE_URL=postgres://service_platform:service_platform_dev@localhost:5432/service_platform?sslmode=disable

# Required. Generate a new key with:
#   openssl genpkey -algorithm ed25519 -outform DER | tail -c 32 | base64
AUTH_JWT_PRIVATE_KEY_BASE64=

# Optional. Defaults shown.
# AUTH_JWT_ISSUER=service-platform
# AUTH_JWT_AUDIENCE=service-platform-api
# AUTH_ACCESS_TOKEN_TTL=15m
# PORT=8080
